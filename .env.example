# AI Command Centre runs with NO configuration and NO API keys.
# Copy to .env only if you want to change a default or enable a cloud provider.
# Never commit .env.

# --- Local inference (the default provider — £0, no account needed) ----------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LOCAL_CONTEXT_TOKENS=16384
# LOCAL_TIMEOUT_MS=180000
# LOCAL_KEEP_ALIVE=30m

# --- Server -----------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# DB_FILE=data/command-centre.db

# --- Optional cloud providers ------------------------------------------------
# These are NEVER required. Set a key only if you deliberately want to use a
# paid model; leave unset and the adapter is simply not registered.
# ANTHROPIC_API_KEY=

# NVIDIA's free evaluation API: Z.ai's GLM-5.3 and Moonshot AI's Kimi K3.
# Free to use, but NOT local — prompts for planning and synthesis leave this
# machine. NVIDIA's trial terms allow evaluation, not production use, and
# forbid personal or confidential data. Create a key at
# https://build.nvidia.com/settings/api-keys, then also list the models in
# config/models.local.json (see the README).
# NVIDIA_API_KEY=
# NVIDIA_TIMEOUT_MS=300000
# NVIDIA_CONTEXT_TOKENS=131072
